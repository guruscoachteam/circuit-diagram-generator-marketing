---
interface Props {
  title?: string;
  desc?: string;
}
const {
  title = '555 timer LED blinker schematic',
  desc = 'A 9 volt battery powers an NE555 wired as an astable multivibrator. R1, R2 and C1 set the blink rate; pin 3 drives an LED through a 470 ohm resistor.',
} = Astro.props;
const uid = 'sch555';
---

<svg class="schem" viewBox="0 0 680 380" role="img" aria-labelledby={`${uid}-t ${uid}-d`}>
  <title id={`${uid}-t`}>{title}</title>
  <desc id={`${uid}-d`}>{desc}</desc>

  <g class="wire">
    <!-- rails -->
    <line x1="72" y1="52" x2="608" y2="52" />
    <line x1="72" y1="332" x2="608" y2="332" />

    <!-- battery -->
    <line x1="100" y1="52" x2="100" y2="160" />
    <line x1="100" y1="196" x2="100" y2="332" />

    <!-- timing column -->
    <line x1="224" y1="52" x2="224" y2="88" />
    <line x1="224" y1="136" x2="224" y2="196" />
    <line x1="224" y1="244" x2="224" y2="308" />
    <line x1="224" y1="318" x2="224" y2="332" />
    <line x1="224" y1="168" x2="292" y2="168" />
    <line x1="224" y1="252" x2="292" y2="252" />
    <line x1="224" y1="280" x2="292" y2="280" />

    <!-- ic pins -->
    <line x1="336" y1="140" x2="336" y2="52" />
    <line x1="396" y1="140" x2="396" y2="52" />
    <line x1="366" y1="310" x2="366" y2="332" />
    <line x1="440" y1="196" x2="520" y2="196" />

    <!-- output branch -->
    <line x1="520" y1="196" x2="520" y2="224" />
    <line x1="520" y1="268" x2="520" y2="282" />
    <line x1="520" y1="306" x2="520" y2="332" />
  </g>

  <!-- battery symbol -->
  <g class="sym">
    <line x1="82" y1="160" x2="118" y2="160" />
    <line x1="91" y1="172" x2="109" y2="172" />
    <line x1="82" y1="184" x2="118" y2="184" />
    <line x1="91" y1="196" x2="109" y2="196" />
  </g>

  <!-- resistors -->
  <g class="sym">
    <rect x="212" y="88" width="24" height="48" rx="1" />
    <rect x="212" y="196" width="24" height="48" rx="1" />
    <rect x="508" y="224" width="24" height="44" rx="1" />
  </g>

  <!-- capacitor -->
  <g class="sym">
    <line x1="204" y1="308" x2="244" y2="308" />
    <line x1="204" y1="318" x2="244" y2="318" />
  </g>

  <!-- led -->
  <g class="sym">
    <path d="M504 282 L536 282 L520 306 Z" />
    <line x1="502" y1="306" x2="538" y2="306" />
    <path class="ray" d="M541 288 L556 275 M541 298 L556 285" />
    <path class="ray-head" d="M556 275 l-6 0.6 M556 275 l0.6 6 M556 285 l-6 0.6 M556 285 l0.6 6" />
  </g>

  <!-- ic body -->
  <rect class="body" x="292" y="140" width="148" height="170" rx="2" />

  <!-- ground -->
  <g class="sym">
    <line x1="452" y1="332" x2="452" y2="344" />
    <line x1="439" y1="344" x2="465" y2="344" />
    <line x1="443" y1="350" x2="461" y2="350" />
    <line x1="448" y1="356" x2="456" y2="356" />
  </g>

  <!-- junctions -->
  <g class="dot">
    <circle cx="100" cy="52" r="3.4" />
    <circle cx="224" cy="52" r="3.4" />
    <circle cx="336" cy="52" r="3.4" />
    <circle cx="396" cy="52" r="3.4" />
    <circle cx="224" cy="168" r="3.4" />
    <circle cx="224" cy="252" r="3.4" />
    <circle cx="224" cy="280" r="3.4" />
    <circle cx="100" cy="332" r="3.4" />
    <circle cx="224" cy="332" r="3.4" />
    <circle cx="366" cy="332" r="3.4" />
    <circle cx="452" cy="332" r="3.4" />
    <circle cx="520" cy="332" r="3.4" />
  </g>

  <!-- pin numbers -->
  <g class="pin">
    <text x="286" y="164" text-anchor="end">7</text>
    <text x="286" y="248" text-anchor="end">6</text>
    <text x="286" y="276" text-anchor="end">2</text>
    <text x="446" y="192">3</text>
    <text x="330" y="134" text-anchor="end">4</text>
    <text x="402" y="134">8</text>
    <text x="372" y="326">1</text>
  </g>

  <!-- labels -->
  <g class="ref">
    <text x="130" y="164">BT1</text>
    <text x="248" y="106">R1</text>
    <text x="248" y="214">R2</text>
    <text x="256" y="306">C1</text>
    <text x="546" y="240">R3</text>
    <text x="560" y="302">LED1</text>
    <text x="302" y="162">IC1</text>
  </g>
  <g class="val">
    <text x="130" y="182">9 V</text>
    <text x="248" y="124">1 kΩ</text>
    <text x="248" y="232">68 kΩ</text>
    <text x="256" y="324">10 µF</text>
    <text x="546" y="258">470 Ω</text>
    <text x="560" y="320">blink 1 Hz</text>
    <text x="72" y="40">V+</text>
    <text x="72" y="356">GND</text>
  </g>

  <text class="part" x="366" y="238" text-anchor="middle">NE555</text>
</svg>
