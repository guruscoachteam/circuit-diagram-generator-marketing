---
interface Props {
  title?: string;
  desc?: string;
}
const {
  title = 'Arduino temperature sensor circuit diagram',
  desc = 'A TMP36 analog temperature sensor powered from the 5 volt rail, decoupled with a 0.1 microfarad capacitor, with its output wired to analog input A0 of an Arduino Uno.',
} = Astro.props;
const uid = 'schsensor';
---

<svg class="schem" viewBox="0 0 680 380" role="img" aria-labelledby={`${uid}-t ${uid}-d`}>
  <title id={`${uid}-t`}>{title}</title>
  <desc id={`${uid}-d`}>{desc}</desc>

  <g class="wire">
    <!-- rails -->
    <line x1="72" y1="60" x2="380" y2="60" />
    <line x1="72" y1="320" x2="400" y2="320" />

    <!-- decoupling cap -->
    <line x1="100" y1="60" x2="100" y2="150" />
    <line x1="100" y1="160" x2="100" y2="320" />

    <!-- sensor power -->
    <line x1="200" y1="60" x2="200" y2="148" />
    <line x1="200" y1="242" x2="200" y2="320" />

    <!-- signal -->
    <line x1="300" y1="190" x2="440" y2="190" />

    <!-- board power -->
    <line x1="380" y1="60" x2="380" y2="132" />
    <line x1="380" y1="132" x2="440" y2="132" />
    <line x1="400" y1="320" x2="400" y2="248" />
    <line x1="400" y1="248" x2="440" y2="248" />
  </g>

  <!-- decoupling capacitor -->
  <g class="sym">
    <line x1="82" y1="150" x2="118" y2="150" />
    <line x1="82" y1="160" x2="118" y2="160" />
  </g>

  <!-- sensor body -->
  <rect class="body" x="160" y="148" width="140" height="94" rx="2" />

  <!-- board body -->
  <rect class="body" x="440" y="88" width="176" height="204" rx="2" />

  <!-- ground -->
  <g class="sym">
    <line x1="330" y1="320" x2="330" y2="332" />
    <line x1="317" y1="332" x2="343" y2="332" />
    <line x1="321" y1="338" x2="339" y2="338" />
    <line x1="326" y1="344" x2="334" y2="344" />
  </g>

  <g class="dot">
    <circle cx="100" cy="60" r="3.4" />
    <circle cx="200" cy="60" r="3.4" />
    <circle cx="100" cy="320" r="3.4" />
    <circle cx="200" cy="320" r="3.4" />
    <circle cx="330" cy="320" r="3.4" />
  </g>

  <g class="pin">
    <text x="208" y="142">+Vs</text>
    <text x="306" y="182">Vout</text>
    <text x="208" y="262">GND</text>
    <text x="434" y="128" text-anchor="end">5V</text>
    <text x="434" y="186" text-anchor="end">A0</text>
    <text x="434" y="244" text-anchor="end">GND</text>
  </g>

  <g class="ref">
    <text x="172" y="172">U2</text>
    <text x="452" y="112">U1</text>
    <text x="76" y="196" text-anchor="end">C1</text>
  </g>
  <g class="val">
    <text x="72" y="48">+5 V</text>
    <text x="72" y="356">GND</text>
    <text x="76" y="214" text-anchor="end">0.1 µF</text>
    <text x="452" y="276">analogRead(A0)</text>
  </g>

  <text class="part" x="230" y="206" text-anchor="middle">TMP36</text>
  <text class="part" x="528" y="200" text-anchor="middle">ARDUINO UNO</text>
</svg>
