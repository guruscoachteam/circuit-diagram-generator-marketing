---
interface Props {
  label?: string;
  alt: string;
  aspect?: string;
}
const { label = 'Screenshot coming soon', alt, aspect = '4 / 3' } = Astro.props;
---

<div class="placeholder" style={`aspect-ratio: ${aspect};`} role="img" aria-label={alt}>
  <span class="placeholder-label">{label}</span>
</div>

<style>
  .placeholder {
    width: 100%;
    display: grid;
    place-items: center;
    background-color: var(--color-bg-deep);
    background-image:
      linear-gradient(var(--color-hair) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-hair) 1px, transparent 1px);
    background-size: var(--grid) var(--grid);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-align: center;
    padding: var(--space-4);
    min-height: 200px;
  }
  .placeholder-label {
    max-width: 30ch;
    line-height: 1.6;
  }
</style>
