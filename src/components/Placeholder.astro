---
interface Props {
  label?: string;
  alt: string;
  aspect?: string;
}
const { label = 'Screenshot coming soon', alt, aspect = '4 / 3' } = Astro.props;
---

<div class="placeholder" style={`aspect-ratio: ${aspect};`} role="img" aria-label={alt}>
  <span class="placeholder-label">{label}</span>
</div>

<style>
  .placeholder {
    width: 100%;
    display: grid;
    place-items: center;
    background:
      linear-gradient(145deg, #fff8ee, #f0ebe4 55%, #e8e2d8);
    color: var(--color-text-muted);
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 600;
    text-align: center;
    padding: var(--space-4);
    min-height: 200px;
  }
  .placeholder-label {
    max-width: 28ch;
    line-height: 1.4;
  }
</style>
