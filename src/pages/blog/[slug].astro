---
export const prerender = true;
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatPostDate, getPublishedPosts, postPath } from '../../lib/blog';
import '../../styles/pages.css';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const canonical = `https://www.circuitdiagramgenerator.ai${postPath(post).replace(/\/$/, '')}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  mainEntityOfPage: canonical,
  author: {
    '@type': 'Organization',
    name: 'Circuit Diagram Generator',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Circuit Diagram Generator',
    url: 'https://www.circuitdiagramgenerator.ai',
  },
};
---

<BaseLayout
  title={`${post.data.title} | Circuit Diagram Generator Blog`}
  description={post.data.description}
  current="blog"
  canonical={canonical}
  jsonLd={jsonLd}
>
  <article class="wrap post">
    <header class="post-header">
      <p class="post-back"><a href="/blog">← Blog</a></p>
      <span class="cdg-kicker">Article</span>
      <h1 class="post-title">{post.data.title}</h1>
      <p class="post-desc">{post.data.description}</p>
      <p class="post-meta">
        <time datetime={post.data.pubDate.toISOString()}>{formatPostDate(post.data.pubDate)}</time>
        {post.data.tags?.length > 0 && (
          <>
            <span aria-hidden="true"> · </span>
            <span>{post.data.tags.join(', ')}</span>
          </>
        )}
      </p>
    </header>

    {post.data.heroImage && (
      <figure class="post-hero plate">
        <img src={post.data.heroImage} alt="" />
      </figure>
    )}

    <div class="post-content">
      <Content />
    </div>

    <footer class="post-footer">
      <a href="https://app.circuitdiagramgenerator.ai/signup?next=/billing" class="btn btn-primary">Start Free Trial</a>
      <a href="/blog" class="btn btn-secondary">More articles</a>
    </footer>
  </article>
</BaseLayout>
