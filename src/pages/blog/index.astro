---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import Placeholder from '../../components/Placeholder.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getPublishedPosts, formatPostDate, postPath } from '../../lib/blog';
import '../../styles/pages.css';

const posts = await getPublishedPosts();
const [lead, ...rest] = posts;
---

<BaseLayout
  title="Blog — AI Circuit Diagram Generator"
  description="Tips and guides for generating circuit diagrams from text or images, plus simulation and export workflows."
  current="blog"
  canonical="https://www.circuitdiagramgenerator.ai/blog"
>
  <div class="cdg-band cdg-hero-band paper">
    <div class="wrap">
      <section class="blog-hero">
        <p class="rule-kicker is-left">Field notes</p>
        <h1 class="blog-h1">Notes on AI <em>circuit</em> design</h1>
        <p class="blog-sub">
          Guides and updates on turning prompts and sketches into working schematics
          with the AI circuit diagram generator.
        </p>
      </section>
    </div>
  </div>

  <div class="wrap">
    {posts.length === 0 ? (
      <section class="blog-empty">
        <p class="title">The first posts are on the way.</p>
        <p class="body">Check back soon for schematic walkthroughs, simulation tips and export guides.</p>
        <a href="/" class="btn btn-secondary">Back to home</a>
      </section>
    ) : (
      <>
        <article class="blog-lead">
          <a href={postPath(lead)} class="blog-lead-media" aria-hidden="true" tabindex="-1">
            {lead.data.heroImage ? (
              <img src={lead.data.heroImage} alt="" loading="eager" />
            ) : (
              <Placeholder alt="" label={lead.data.title} aspect="16 / 10" />
            )}
          </a>
          <div class="blog-lead-body">
            <p class="blog-card-tag">
              {lead.data.tags?.[0] ?? 'Latest'}
              <span class="blog-dot" aria-hidden="true">·</span>
              <time datetime={lead.data.pubDate.toISOString()}>
                {formatPostDate(lead.data.pubDate)}
              </time>
            </p>
            <h2 class="blog-lead-title">
              <a href={postPath(lead)}>{lead.data.title}</a>
            </h2>
            <p class="blog-lead-desc">{lead.data.description}</p>
            <p class="blog-read">
              <a href={postPath(lead)}>Read the guide →</a>
            </p>
          </div>
        </article>

        {rest.length > 0 && (
          <section class="blog-grid" aria-label="More articles">
            {rest.map((post) => (
              <article class="blog-card">
                <a href={postPath(post)} class="blog-card-media" aria-hidden="true" tabindex="-1">
                  {post.data.heroImage ? (
                    <img src={post.data.heroImage} alt="" loading="lazy" />
                  ) : (
                    <Placeholder alt="" label={post.data.title} aspect="16 / 10" />
                  )}
                </a>
                <div class="blog-card-body">
                  <p class="blog-card-tag">
                    {post.data.tags?.[0] ?? 'Article'}
                    <span class="blog-dot" aria-hidden="true">·</span>
                    <time datetime={post.data.pubDate.toISOString()}>
                      {formatPostDate(post.data.pubDate)}
                    </time>
                  </p>
                  <h2>
                    <a href={postPath(post)}>{post.data.title}</a>
                  </h2>
                  <p>{post.data.description}</p>
                </div>
              </article>
            ))}
          </section>
        )}
      </>
    )}
  </div>

  <CtaBand
    kicker="From reading to drawing"
    title="Try it on your <em>next</em> circuit"
    sub="Describe a circuit or upload a sketch and get an editable, simulation-ready schematic in minutes."
  />
</BaseLayout>
