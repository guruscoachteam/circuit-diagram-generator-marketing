---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/pages.css';
---

<BaseLayout
  title="Blog — AI Circuit Diagram Generator | circuitdiagramgenerator.ai"
  description="Guides, tutorials and updates from the AI circuit diagram generator team: schematic design tips, simulation walkthroughs, and export workflows."
  current="blog"
  canonical="https://www.circuitdiagramgenerator.ai/blog"
>
  <div class="wrap">
    <section class="blog-hero">
      <span class="cdg-kicker">Blog</span>
      <h1 class="blog-h1">Notes on AI circuit design</h1>
      <p class="blog-sub">
        Guides and updates on turning prompts and sketches into working schematics with the AI circuit diagram generator — coming soon.
      </p>
    </section>

    <hr class="hr" style="margin:0;" />

    <section class="blog-empty">
      <p class="title">The first posts are on the way.</p>
      <p class="body">Check back soon for schematic walkthroughs, simulation tips and export guides.</p>
      <a href="/" class="btn btn-secondary">Back to home</a>
    </section>
  </div>
</BaseLayout>
