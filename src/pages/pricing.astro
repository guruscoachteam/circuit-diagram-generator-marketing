---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import IconCheck from '../components/IconCheck.astro';
import IconPlus from '../components/IconPlus.astro';
import CtaBand from '../components/CtaBand.astro';
import { app } from '../lib/app';
import '../styles/pages.css';

const pricingFaq = [
  {
    q: 'Is there a free trial?',
    a: 'Every plan starts with a 7-day free trial. A card is required to start it, and you can cancel anytime before it ends.',
  },
  {
    q: 'What happens if I use all my AI credits?',
    a: "You can keep generating at the plan's per-credit overage rate, or upgrade to the next plan for a larger monthly allowance.",
  },
  {
    q: 'Can I switch plans later?',
    a: 'Yes, upgrade or downgrade anytime from your billing settings; changes apply to your next billing cycle.',
  },
  {
    q: 'Do you offer education or team discounts?',
    a: 'Contact us from your billing settings for classroom or larger team pricing beyond the Studio plan.',
  },
];

const specs = [
  { k: 'Trial', v: '7 days, every plan' },
  { k: 'Billing', v: 'Monthly, cancel anytime' },
  { k: 'Seats', v: '1 to 10' },
  { k: 'Exports', v: 'KiCad · Eagle · PDF · SVG' },
];

const plans = [
  {
    n: '01',
    name: 'Starter',
    price: '$19',
    desc: 'For students and hobbyists getting a first schematic drafted and simulated.',
    features: [
      '100 AI credits / month',
      '1 seat',
      'Unlimited saved circuits',
      'Built-in simulation',
      'PDF & SVG export',
      '$0.15 per credit over plan',
    ],
    cta: 'Start with Starter',
    featured: false,
  },
  {
    n: '02',
    name: 'Pro',
    price: '$49',
    desc: 'For engineers and teachers running several projects with room for a small team.',
    features: [
      '300 AI credits / month',
      'Up to 3 seats',
      'Unlimited saved circuits',
      'Built-in simulation',
      'KiCad, Eagle, PDF & SVG export',
      '$0.12 per credit over plan',
    ],
    cta: 'Start with Pro',
    featured: true,
  },
  {
    n: '03',
    name: 'Studio',
    price: '$99',
    desc: 'For teams shipping schematics into production documentation at volume.',
    features: [
      '750 AI credits / month',
      'Up to 10 seats',
      'Unlimited saved circuits',
      'Built-in simulation',
      'KiCad, Eagle, PDF & SVG export',
      'Priority support',
    ],
    cta: 'Start with Studio',
    featured: false,
  },
];

const compare = [
  ['AI credits / month', '100', '300', '750'],
  ['Seats', '1', '3', '10'],
  ['Saved circuits', 'Unlimited', 'Unlimited', 'Unlimited'],
  ['Prompt-to-schematic', true, true, true],
  ['Sketch & photo import', true, true, true],
  ['Built-in simulation', true, true, true],
  ['PDF & SVG export', true, true, true],
  ['KiCad & Eagle export', false, true, true],
  ['Overage rate', '$0.15/credit', '$0.12/credit', '$0.10/credit'],
  ['Priority support', false, false, true],
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Circuit Diagram Generator',
  description: 'AI circuit diagram generator with manual editing, AI-assisted revisions, simulation and engineering exports.',
  offers: [
    { '@type': 'Offer', name: 'Starter', price: '19', priceCurrency: 'USD', url: 'https://www.circuitdiagramgenerator.ai/pricing' },
    { '@type': 'Offer', name: 'Pro', price: '49', priceCurrency: 'USD', url: 'https://www.circuitdiagramgenerator.ai/pricing' },
    { '@type': 'Offer', name: 'Studio', price: '99', priceCurrency: 'USD', url: 'https://www.circuitdiagramgenerator.ai/pricing' },
  ],
};
---

<BaseLayout
  title="Pricing — AI Circuit Diagram Generator"
  description="Compare Starter, Pro & Studio plans. AI circuit diagrams from text or image. Every plan includes a 7-day free trial."
  current="pricing"
  canonical="https://www.circuitdiagramgenerator.ai/pricing"
  jsonLd={jsonLd}
>
  <div class="cdg-band cdg-hero-band paper">
    <div class="wrap">
      <section class="pr-hero">
        <p class="rule-kicker">Pricing</p>
        <h1 class="pr-h1">Plans for every bench, classroom and <em>team</em></h1>
        <p class="pr-sub">
          Every plan on the AI circuit diagram generator opens with a 7-day free trial.
          A card is required to start, and you can cancel anytime before it ends.
        </p>
      </section>
    </div>
  </div>

  <div class="cdg-band cdg-spec-band">
    <div class="wrap">
      <dl class="cdg-spec">
        {specs.map((s) => (
          <div>
            <dt>{s.k}</dt>
            <dd>{s.v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>

  <div class="wrap">
    <section class="pr-grid" aria-label="Pricing plans">
      {plans.map((plan) => (
        <div class={`card pr-plan${plan.featured ? ' cdg-featured' : ''}`}>
          {plan.featured && (
            <span class="tag tag-outline pr-badge">Most popular</span>
          )}
          <p class="card-kicker">Plan {plan.n}</p>
          <h2 class="pr-plan-name">{plan.name}</h2>
          <p class="pr-price">{plan.price}<span> / mo</span></p>
          <p class="pr-plan-desc">{plan.desc}</p>
          <ul>
            {plan.features.map((f) => (
              <li><IconCheck />{f}</li>
            ))}
          </ul>
          <a
            href={app.billing}
            class={`btn btn-block ${plan.featured ? 'btn-primary' : 'btn-secondary'}`}
          >{plan.cta}</a>
        </div>
      ))}
    </section>

    <section class="pr-compare">
      <div class="cdg-section-head">
        <h2 class="cdg-h2">Compare the <em>plans</em></h2>
        <p class="cdg-sub">
          Credits are spent on generation and AI revisions. Editing, simulating and
          exporting a circuit you already made is always free.
        </p>
      </div>
      <div class="pr-table-scroll">
        <table class="pr-table">
          <thead>
            <tr><th>Feature</th><th>Starter</th><th>Pro</th><th>Studio</th></tr>
          </thead>
          <tbody>
            {compare.map(([label, ...cells]) => (
              <tr>
                <td>{label}</td>
                {cells.map((cell) => (
                  <td>
                    {cell === true && <span class="pr-yes" aria-label="Included">✓</span>}
                    {cell === false && <span class="pr-no" aria-label="Not included">—</span>}
                    {typeof cell === 'string' && cell}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section id="faq" class="cdg-section">
      <div class="cdg-section-head">
        <h2 class="cdg-h2">Pricing <em>questions</em></h2>
        <p class="cdg-sub">
          Anything else about billing, seats or credits is answered in your billing
          settings once the trial starts.
        </p>
      </div>
      <div>
        {pricingFaq.map((item, i) => (
          <details class="cdg-faq-item" open={i === 0}>
            <summary>{item.q}<IconPlus /></summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </section>
  </div>

  <CtaBand
    kicker="Ready to start"
    title="Pick a plan, draw your <em>first</em> circuit"
    sub="Every plan opens with a 7-day free trial. Generate from text or from a photo, simulate, and export when you're ready."
    primaryLabel="Start free trial →"
    secondaryLabel="See how it works"
    secondaryHref="/#how-it-works"
  />
</BaseLayout>
