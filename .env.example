# Copy to .env for local reference. Set these in Cloudflare Pages → Settings → Environment variables.

# Repo Keystatic writes to in production (GitHub mode)
GITHUB_REPO_OWNER=guruscoachteam
GITHUB_REPO_NAME=circuit-diagram-generator-marketing

# Created by Keystatic GitHub App setup (visit /keystatic once in production, or create an OAuth/GitHub App)
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=

# Astro public env for the GitHub App slug (set after Keystatic creates the app)
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
